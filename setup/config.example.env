# Deployment settings. Copy to config.env (git-ignored) and fill in:  cp config.example.env config.env
# ssm-run.sh, deploy-team.sh and share-assistants.sh read it; scripts that run on the server get
# these values as environment variables. Env vars you set on the command line win.

AWS_REGION=us-east-1
INSTANCE_ID=               # printed by provision.sh, e.g. i-0123456789abcdef0

# Your Buzz community
RELAY_URL=                 # e.g. wss://yourteam.communities.buzz.xyz
OWNER_HEX=                 # your Buzz public key in hex (Buzz Desktop > profile; convert npub with any nostr tool)
RELAY_SELF_HEX=            # relay "self" key: curl -s -H 'Accept: application/nostr+json' https://yourteam.communities.buzz.xyz | grep -o '"self":"[^"]*"'
GENERAL_CHANNEL_ID=        # UUID of the existing #general channel
ENGINEERING_CHANNEL_ID=    # UUID of the existing #engineering channel

# Used in the agents' prompts ({{TEAM_NAME}}, {{OWNER_NAME}} in prompts/*.md)
TEAM_NAME=                 # e.g. Acme
OWNER_NAME=                # your display name in Buzz, e.g. Sam
