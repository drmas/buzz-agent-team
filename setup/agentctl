#!/bin/bash
# agentctl — manage isolated Buzz agent containers on this host (run as root).
#
#   agentctl list
#   agentctl add <id> <claude|codex> --name NAME [--about TEXT] [--respond-to MODE] [--mem 2g] [--kind team|solo]
#                [--model M] [--effort E]
#   agentctl model <id> [<model|default|-> [effort|default|-]] [--no-restart]   # no args: show; - keeps current
#   agentctl mem <id> [size] [--no-restart]   # show or change the memory limit, e.g. 4g (headless Chrome needs ~1-2g)
#   agentctl skills <id> [name ...|none] [--no-restart]   # show or set its opt-in skills (from skill-library.txt)
#   agentctl skills-fetch              # download skill-library.txt skills at their pinned commits
#   agentctl runtime <id> <claude|codex> [--no-restart]   # switch runtime; keeps identity, memory, workspace, instructions
#   agentctl profile <id> --name NAME [--about TEXT]
#   agentctl login-codex <id>          # ChatGPT device login for a codex agent
#   agentctl restart <id> | logs <id> | remove <id> [--purge]
#   agentctl prep-all                  # (re)apply skills + seed instructions files, re-render
#   agentctl sync                      # rebuild prompts (roster!) and restart agents whose prompt changed
#   agentctl respond-to <id> <owner-only|anyone|nobody>
#   agentctl auth <id> '<auth tag json>'   # NIP-OA owner proof (sign on your laptop: sign-owner-proofs.py)
#   agentctl mirror [id ...]           # copy each agent's ~/memory into its Buzz memory (nightly timer)
#   agentctl listen <id> [channel-name ...]  # channels where the agent reads every human message (none = mentions only)
#   agentctl prune-exchange [days]     # delete handoffs older than N days (default 30; nightly timer)
#
# Registry: agents.list ("<id> <runtime> <mem> <kind>"); <id>.meta = display name / about.
# Prompt sources: prompts/src/<id>.md (role), _team.md (team agents only), _turns.md, _people.md
# (humans + company, edit by hand), _instructions.md, _files.md, _proof.md, _delegate.md (Claude agents),
# _delegate-codex.md (Codex agents), _ambient.md (Codex agents that listen). Built per agent into prompts/<id>.md (mounted read-only at /prompts)
# with an auto-generated "Who's who" roster.
# Model and effort live in <id>.env: ANTHROPIC_MODEL + CLAUDE_CODE_EFFORT_LEVEL (Claude) or
# CODEX_CONFIG={"model":…,"model_reasoning_effort":…} (Codex). Claude agents also get
# claude/managed-settings.json (ambient-gate hook) and the claude/agents/ subagents, read-only;
# Codex agents get the codex/agents/ custom agents. Skills: skills/* go to every agent; the opt-in
# ones listed in <id>.skills come from skill-library/ (see skill-library.txt).
# File handoffs: exchange/<id>/ is the agent's /outbox (only it can write there); the whole
# exchange/ is mounted read-only at /exchange in every agent (see tools/handoff).
set -euo pipefail
DIR=/opt/buzz-agents
cd "$DIR"
KEYGEN_IMAGE=ghcr.io/block/buzz:main
RELAY_URL=$(sed -n 's/^RELAY_URL=//p' .env)
OWNER_HEX=$(cat owner.hex)
OWNER_NAME=$(cat owner.name 2>/dev/null || echo "the owner")
dc() { docker compose -p buzz-agents "$@"; }
die() { echo "error: $*" >&2; exit 1; }

npub() {
  python3 - "$1" <<'PY'
import sys
C="qpzry9x8gf2tvdw0s3jn54khce6mua7l"
def pm(v):
    g=[0x3b6a57b2,0x26508e6d,0x1ea119fa,0x3d4233dd,0x2a1462b3];c=1
    for x in v:
        b=c>>25;c=(c&0x1ffffff)<<5^x
        for i in range(5): c^=g[i] if (b>>i)&1 else 0
    return c
acc=bits=0;d=[]
for b in bytes.fromhex(sys.argv[1]):
    acc=(acc<<8)|b;bits+=8
    while bits>=5: bits-=5;d.append((acc>>bits)&31)
if bits: d.append((acc<<(5-bits))&31)
e=[ord(x)>>5 for x in "npub"]+[0]+[ord(x)&31 for x in "npub"]
p=pm(e+d+[0]*6)^1
print("npub1"+"".join(C[x] for x in d+[(p>>5*(5-i))&31 for i in range(6)]))
PY
}

render() {
  local id rt mem kind cfg sk
  {
    cat <<'EOF'
# GENERATED by agentctl from agents.list — edit agents.list / use agentctl, not this file.
x-agent: &agent
  build: .
  image: buzz-agent:local
  restart: on-failure            # an owner !shutdown stays stopped
  read_only: true
  tmpfs: ["/tmp:size=512m"]
  shm_size: 1g                   # headless Chrome crashes with Docker's 64 MB /dev/shm; counts toward mem_limit only when used
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  pids_limit: 512
  cpus: 1.5
  logging:
    driver: json-file
    options: { max-size: "10m", max-file: "3" }

services:
EOF
    while read -r id rt mem kind; do
      [ -z "${id:-}" ] && continue
      echo "  $id:"
      echo "    <<: *agent"
      echo "    mem_limit: $mem"
      echo "    environment:"
      echo "      BUZZ_RELAY_URL: \${RELAY_URL}"
      echo "      PATH: /opt/agent-tools:/home/agent/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
      echo "      NPM_CONFIG_PREFIX: /home/agent/.local       # npm -g installs (plugins, MCP servers) go to the agent's home"
      echo "      BUZZ_ACP_NO_MEMORY: \"true\"               # file memory (~/memory, mem) replaces injected core memory"
      echo "      BUZZ_ACP_MAX_TURNS_PER_SESSION: \"40\"     # fresh context every 40 turns; memory carries continuity"
      echo "      AGENT_PUBKEY: \"$(cat "$id.pub")\"   # turn-gate: which roster row is me"
      echo "      AGENT_ID: $id                             # handoff: /outbox is /exchange/$id for the others"
      if [ "$rt" = claude ]; then
        echo "      CLAUDE_CODE_EXECUTABLE: /usr/local/bin/claude"
        echo "      DISABLE_AUTOUPDATER: \"1\""
        echo "      CLAUDE_CODE_DISABLE_AUTO_MEMORY: \"1\"   # no auto-loaded MEMORY.md; use ~/memory on demand"
        echo "      AGENT_INSTRUCTIONS_FILE: /home/agent/.claude/CLAUDE.md"
        cfg=.claude
      else
        echo "      CODEX_PATH: /usr/local/bin/codex"
        echo "      NO_BROWSER: \"1\""
        echo "      AGENT_INSTRUCTIONS_FILE: /home/agent/.codex/AGENTS.md"
        cfg=.codex
      fi
      echo "    env_file:"
      echo "      - $id.env"
      echo "      - { path: secrets/$rt.env, required: false }"
      echo "      - { path: secrets/common.env, required: false }   # TYPESAFE_API_KEY (turn-gate, ambient-gate)"
      echo "    volumes:"
      echo "      - $id-home:/home/agent"
      echo "      - $id-ws:/workspace"
      echo "      - ./prompts:/prompts:ro"
      echo "      - ./rules:/rules:ro"
      echo "      - ./tools:/opt/agent-tools:ro"
      echo "      - ./exchange:/exchange:ro          # every agent's handoffs, read-only"
      echo "      - ./exchange/$id:/outbox           # this agent's handoffs (handoff tool)"
      for sk in skills/*/; do
        [ -d "$sk" ] || continue; sk=$(basename "$sk")
        echo "      - ./skills/$sk:/home/agent/$cfg/skills/$sk:ro"
      done
      for sk in $(cat "$id.skills" 2>/dev/null); do
        [ -f "skill-library/$sk/SKILL.md" ] || continue
        echo "      - ./skill-library/$sk:/home/agent/$cfg/skills/$sk:ro"
      done
      if [ "$rt" = claude ]; then
        echo "      - ./claude/managed-settings.json:/etc/claude-code/managed-settings.json:ro   # ambient-gate hook"
        echo "      - ./claude/agents:/home/agent/.claude/agents/team:ro   # explorer / researcher / planner / worker / reviewer / deep-work"
      else
        echo "      - ./codex/agents:/home/agent/.codex/agents:ro   # explorer / researcher / planner / worker / reviewer roles"
      fi
      echo "    networks: [$id-net]"
    done < agents.list
    echo; echo "networks:"
    while read -r id _; do [ -n "${id:-}" ] && echo "  $id-net: {}"; done < agents.list
    echo; echo "volumes:"
    while read -r id _; do [ -n "${id:-}" ] && { echo "  $id-home: {}"; echo "  $id-ws: {}"; }; done < agents.list
  } > compose.yml.new
  mv compose.yml.new compose.yml
}

# Make sure the agent's config dir is agent-owned before read-only skill mounts are nested in
# it, and seed the team-editable instructions file.
prep_home() {  # id runtime
  local cfg file
  install -d -m 755 exchange; install -d -m 755 -o 1000 -g 1000 "exchange/$1"
  if [ "$2" = claude ]; then cfg=.claude; file=CLAUDE.md; else cfg=.codex; file=AGENTS.md; fi
  docker run --rm -v "buzz-agents_$1-home:/h" -v "$DIR/instructions-header.md:/header.md:ro" \
    -e CFG="$cfg" -e FILE="$file" alpine sh -c '
      mkdir -p "/h/$CFG/skills" "/h/$CFG/agents" /h/instructions-history
      [ -f "/h/$CFG/$FILE" ] || cp /header.md "/h/$CFG/$FILE"
      chown 1000:1000 "/h/$CFG" "/h/$CFG/skills" "/h/$CFG/agents" "/h/$CFG/$FILE" /h/instructions-history'
}

# skill-library/<name>/ from skill-library.txt at the pinned commit. Updated in place (same
# directory) so running agents' read-only mounts stay valid.
fetch_skills() {
  local name repo sha path cache src
  install -d -m 755 skill-library
  cache=$(mktemp -d); trap "rm -rf '$cache'" EXIT   # expanded now: $cache is local, gone at exit
  while read -r name repo sha path; do
    case "${name:-#}" in '#'*) continue;; esac
    [ "$(cat "skill-library/$name/.commit" 2>/dev/null)" = "$sha" ] && continue
    if [ ! -d "$cache/$sha" ]; then   # one download per repo commit
      mkdir "$cache/$sha"
      curl -fsSL "https://codeload.github.com/$repo/tar.gz/$sha" | tar -xz -C "$cache/$sha" || die "download failed: $repo@$sha"
    fi
    src=$(echo "$cache/$sha"/*/"$path")
    [ -f "$src/SKILL.md" ] || die "$repo@$sha has no $path/SKILL.md"
    install -d -m 755 "skill-library/$name"
    find "skill-library/$name" -mindepth 1 -delete
    cp -r "$src/." "skill-library/$name/"; find "skill-library/$name" -name '*.zip' -delete
    echo "$sha" > "skill-library/$name/.commit"
    chown -R root:root "skill-library/$name"; chmod -R a+rX,go-w "skill-library/$name"
    echo "skill $name: $repo@${sha:0:7}"
  done < skill-library.txt
}

# Build prompts/<id>.md for every agent; print the ids whose prompt changed.
build_prompts() {
  local id rt mem kind name about resp rtl out tmp lst
  mkdir -p prompts/src
  {
    echo "## Who's who"
    echo
    echo "### AI agents (each runs in its own container on the team server)"
    echo
    echo "| Name | Pubkey (for --mention) | Runtime | Responds to | Listens without mention in | What they do |"
    echo "|---|---|---|---|---|---|"
    while read -r id rt mem kind; do
      [ -z "${id:-}" ] && continue
      name=$(sed -n 1p "$id.meta" 2>/dev/null || true); about=$(sed -n 2p "$id.meta" 2>/dev/null || true)
      resp=$(sed -n 's/^BUZZ_ACP_RESPOND_TO=//p' "$id.env")
      case "${resp:-owner-only}" in owner-only) resp="$OWNER_NAME only";; anyone) resp="anyone";; *) resp="nobody";; esac
      [ "$rt" = claude ] && rtl="Claude Code" || rtl="Codex"
      lst=$( { cat "$id.listen" 2>/dev/null || true; } | sed 's/[^ ][^ ]*/#&/g'); lst=${lst:-mentions only}
      echo "| ${name:-$id} | \`$(cat "$id.pub")\` | $rtl | $resp | $lst | $about |"
    done < agents.list
    echo
    echo "To mention someone, write @Name in the text **and** pass their pubkey with"
    echo "\`buzz messages send ... --mention <pubkey>\` (look up humans with \`buzz users get --name <Name>\`)."
    echo "Agents that respond to \"$OWNER_NAME only\" ignore mentions from anyone else, including you."
    echo
    cat prompts/src/_people.md 2>/dev/null
  } > prompts/_roster.md
  while read -r id rt mem kind; do
    [ -z "${id:-}" ] && continue
    out="prompts/$id.md"; tmp=$(mktemp)
    {
      [ -f "prompts/src/$id.md" ] && { cat "prompts/src/$id.md"; echo; }
      [ "${kind:-team}" = team ] && [ -f prompts/src/_team.md ] && { cat prompts/src/_team.md; echo; }
      [ -f prompts/src/_turns.md ] && { cat prompts/src/_turns.md; echo; }
      [ -f prompts/src/_files.md ] && { cat prompts/src/_files.md; echo; }
      [ -f prompts/src/_proof.md ] && { cat prompts/src/_proof.md; echo; }
      [ "$rt" = claude ] && [ -f prompts/src/_delegate.md ] && { cat prompts/src/_delegate.md; echo; }
      [ "$rt" = codex ] && [ -f prompts/src/_delegate-codex.md ] && { cat prompts/src/_delegate-codex.md; echo; }
      [ "$rt" = codex ] && [ -s "$id.listen" ] && [ -f prompts/src/_ambient.md ] && { cat prompts/src/_ambient.md; echo; }
      cat prompts/_roster.md; echo
      [ -f prompts/src/_instructions.md ] && cat prompts/src/_instructions.md
    } > "$tmp"
    if ! cmp -s "$tmp" "$out"; then mv "$tmp" "$out"; chmod 644 "$out"; echo "$id"; else rm -f "$tmp"; fi
    grep -q '^BUZZ_ACP_SYSTEM_PROMPT_FILE=' "$id.env" || { echo "BUZZ_ACP_SYSTEM_PROMPT_FILE=/prompts/$id.md" >> "$id.env"; echo "$id"; }
    build_rules "$id"
  done < agents.list
}

# rules/<id>.toml: mentions everywhere (unchanged behaviour) + read every *human* message in the
# channels listed in <id>.listen. Messages from agents and the relay (workflows) never match the
# listening rule, so agents can't trigger each other without an explicit mention.
build_rules() {
  local id=$1 out="rules/$1.toml" tmp chans="" excl="" pk n cid before after
  mkdir -p rules; chmod 755 rules
  before=$( { md5sum "$out" "$id.env" 2>/dev/null || true; } | md5sum)
  if [ -s "$id.listen" ]; then
    for n in $(cat "$id.listen"); do
      cid=$(python3 -c "import json,sys; print(json.load(open('channels.json')).get(sys.argv[1],''))" "$n")
      [ -n "$cid" ] && chans="$chans\"$cid\", " || echo "warning: unknown channel #$n for $id" >&2
    done
    for pk in $(cat *.pub) $(cat relay.hex 2>/dev/null); do excl="$excl && author != \"$pk\""; done
    tmp=$(mktemp)
    {
      echo "# GENERATED by agentctl — edit $id.listen and run: agentctl sync"
      echo "[[rules]]"; echo 'name = "mention"'; echo 'channels = "all"'
      echo "kinds = [9, 40007, 46010]"; echo "require_mention = true"
      echo; echo "[[rules]]"; echo 'name = "ambient"'; echo "channels = [${chans%, }]"
      echo "kinds = [9]"; echo "require_mention = false"
      echo "filter = '${excl# && }'"
    } > "$tmp"
    cmp -s "$tmp" "$out" || { mv "$tmp" "$out"; chmod 644 "$out"; }; rm -f "$tmp"
    grep -q '^BUZZ_ACP_SUBSCRIBE=config' "$id.env" || { sed -i '/^BUZZ_ACP_SUBSCRIBE=/d;/^BUZZ_ACP_CONFIG=/d' "$id.env"; printf 'BUZZ_ACP_SUBSCRIBE=config\nBUZZ_ACP_CONFIG=/rules/%s.toml\n' "$id" >> "$id.env"; }
  else
    rm -f "$out"; sed -i '/^BUZZ_ACP_SUBSCRIBE=/d;/^BUZZ_ACP_CONFIG=/d' "$id.env"
  fi
  after=$( { md5sum "$out" "$id.env" 2>/dev/null || true; } | md5sum)
  [ "$before" = "$after" ] || echo "$id"
}

sync_prompts() {  # rebuild; recreate only agents whose prompt/env changed
  local changed
  changed=$(build_prompts | sort -u | tr '\n' ' ')
  if [ -n "${changed// }" ]; then
    echo "prompt changed: $changed"
    dc up -d --force-recreate $changed 2>&1 | grep -E "Started|Error" || true
  else echo "prompts unchanged"; fi
}

runtime_of() { awk -v id="$1" '$1==id{print $2}' agents.list; }

envget() { sed -n "s/^$2=//p" "$1.env" | tail -1; }            # id key
envset() { sed -i "/^$2=/d" "$1.env"; [ -z "$3" ] || echo "$2=$3" >> "$1.env"; }   # id key value (empty = unset)

# "model effort" of an agent ("default" = the runtime's own choice).
model_of() {  # id
  local m e
  if [ "$(runtime_of "$1")" = claude ]; then m=$(envget "$1" ANTHROPIC_MODEL); e=$(envget "$1" CLAUDE_CODE_EFFORT_LEVEL)
  else
    read -r m e < <(python3 -c 'import json,sys; c=json.loads(sys.argv[1] or "{}"); print(c.get("model") or "default", c.get("model_reasoning_effort") or "default")' "$(envget "$1" CODEX_CONFIG)")
  fi
  echo "${m:-default} ${e:-default}"
}

set_model() {  # id model effort  ("-" keeps the current value, "default" clears it)
  local id=$1 rt m e cur
  rt=$(runtime_of "$id"); [ -n "$rt" ] || die "no agent $id"
  read -r m e <<<"$(model_of "$id")"
  [ "$2" = - ] || m=$2; [ "${3:--}" = - ] || e=$3
  [ "$m" = default ] && m=""; [ "$e" = default ] && e=""
  local re='^[][A-Za-z0-9._:/-]*$'; [[ "$m" =~ $re ]] || die "bad model name: $m"
  if [ "$rt" = claude ]; then
    [[ "$e" =~ ^(|low|medium|high|xhigh|max)$ ]] || die "claude effort: low|medium|high|xhigh|max|default"
    envset "$id" ANTHROPIC_MODEL "$m"; envset "$id" CLAUDE_CODE_EFFORT_LEVEL "$e"
  else
    [[ "$e" =~ ^(|minimal|low|medium|high|xhigh)$ ]] || die "codex effort: minimal|low|medium|high|xhigh|default"
    cur=$(python3 -c 'import json,sys
c=json.loads(sys.argv[1] or "{}")
for k,v in (("model",sys.argv[2]),("model_reasoning_effort",sys.argv[3])):
    c.pop(k,None)
    if v: c[k]=v
print(json.dumps(c,separators=(",",":")) if c else "")' "$(envget "$id" CODEX_CONFIG)" "$m" "$e")
    envset "$id" CODEX_CONFIG "$cur"
  fi
  echo "$id: model ${m:-default}, effort ${e:-default}"
}

set_profile() {  # id name about
  for i in $(seq 20); do dc exec -T "$1" true </dev/null >/dev/null 2>&1 && break; sleep 2; done
  dc exec -T "$1" buzz users set-profile --name "$2" --about "$3" </dev/null | grep -q '"accepted":true' \
    && echo "profile: $2" || echo "warning: profile not accepted for $1"
}

login_codex() {
  [ "$(runtime_of "$1")" = codex ] || die "$1 is not a codex agent"
  docker rm -f "login-$1" >/dev/null 2>&1 || true
  dc run -d --no-deps --name "login-$1" --entrypoint codex "$1" login --device-auth </dev/null >/dev/null 2>&1
  sleep 8
  docker logs "login-$1" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E "https://|^[[:space:]]+[A-Z0-9]{4}-[A-Z0-9]{4,}" || echo "(no code yet: docker logs login-$1)"
}

cmd=${1:-list}; shift || true
case "$cmd" in
  list)
    printf "%-10s %-7s %-16s %-5s %-22s %s\n" ID RUNTIME MODEL MEM STATUS NPUB
    while read -r id rt mem _; do
      [ -z "${id:-}" ] && continue
      st=$(docker inspect -f '{{.State.Status}}' "buzz-agents-$id-1" 2>/dev/null | head -1 || true); [ -n "$st" ] || st="not created"
      printf "%-10s %-7s %-16s %-5s %-22s %s\n" "$id" "$rt" "$(model_of "$id" | tr ' ' /)" "$mem" "$st" "$(npub "$(cat "$id.pub")")"
    done < agents.list ;;

  model)
    id=${1:?id}; shift; [ -n "$(runtime_of "$id")" ] || die "no agent $id"
    restart=1; pos=()
    for a in "$@"; do [ "$a" = --no-restart ] && restart=0 || pos+=("$a"); done
    if [ ${#pos[@]} -eq 0 ]; then read -r m e <<<"$(model_of "$id")"; echo "$id: model $m, effort $e"; exit 0; fi
    set_model "$id" "${pos[0]}" "${pos[1]:--}"
    if [ $restart = 1 ]; then dc up -d --force-recreate "$id" 2>&1 | grep -E "Started|Error" || true; fi ;;

  mem)
    id=${1:?id}; [ -n "$(runtime_of "$id")" ] || die "no agent $id"
    if [ -z "${2:-}" ]; then echo "$id: memory limit $(awk -v id="$id" '$1==id{print $3}' agents.list)"; exit 0; fi
    [[ "$2" =~ ^[0-9]+[mg]$ ]] || die "size like 4g or 3584m"
    awk -v id="$id" -v m="$2" '$1==id{$3=m}1' agents.list > agents.list.new && mv agents.list.new agents.list
    render
    echo "$id: memory limit $2"
    if [ "${3:-}" != --no-restart ]; then dc up -d "$id" 2>&1 | grep -E "Recreated|Started|Error" || true; fi ;;

  skills)
    id=${1:?id}; shift; [ -n "$(runtime_of "$id")" ] || die "no agent $id"
    restart=1; names=()
    for a in "$@"; do [ "$a" = --no-restart ] && restart=0 || names+=("$a"); done
    if [ ${#names[@]} -eq 0 ]; then
      echo "$id: $(cat "$id.skills" 2>/dev/null || echo none) (+ $(ls skills | tr '\n' ' ')for everyone)"
      echo "available: $(ls skill-library 2>/dev/null | tr '\n' ' ')"; exit 0
    fi
    [ "${names[*]}" = none ] && names=()
    for n in "${names[@]}"; do [ -f "skill-library/$n/SKILL.md" ] || die "no skill $n (see skill-library.txt; agentctl skills-fetch)"; done
    if [ ${#names[@]} -gt 0 ]; then echo "${names[*]}" > "$id.skills"; else rm -f "$id.skills"; fi
    render
    echo "$id skills: ${names[*]:-none}"
    if [ $restart = 1 ]; then dc up -d "$id" 2>&1 | grep -E "Recreated|Started|Error" || true; fi ;;
  skills-fetch) fetch_skills ;;

  runtime)
    id=${1:?id}; new=${2:?runtime}; [[ "$new" =~ ^(claude|codex)$ ]] || die "runtime must be claude or codex"
    old=$(runtime_of "$id"); [ -n "$old" ] || die "no agent $id"
    [ "$old" = "$new" ] && { echo "$id already runs $new"; exit 0; }
    # Model names don't carry across runtimes: clear them (set new ones with: agentctl model).
    for k in ANTHROPIC_MODEL CLAUDE_CODE_EFFORT_LEVEL CODEX_CONFIG; do envset "$id" "$k" ""; done
    envset "$id" BUZZ_ACP_AGENT_COMMAND "$([ "$new" = claude ] && echo claude-agent-acp || echo codex-acp)"
    awk -v id="$id" -v rt="$new" '$1==id{$2=rt}1' agents.list > agents.list.new && mv agents.list.new agents.list
    # Carry the team-editable standing instructions over (same home volume; memory and workspace stay).
    if [ "$new" = claude ]; then from=.codex/AGENTS.md; to=.claude/CLAUDE.md; else from=.claude/CLAUDE.md; to=.codex/AGENTS.md; fi
    docker run --rm -v "buzz-agents_$id-home:/h" -e FROM="$from" -e TO="$to" alpine sh -c '
      mkdir -p "/h/$(dirname "$TO")"
      [ -f "/h/$FROM" ] && [ ! -f "/h/$TO" ] && cp "/h/$FROM" "/h/$TO" && chown 1000:1000 "/h/$(dirname "$TO")" "/h/$TO" || true'
    prep_home "$id" "$new"
    render
    echo "$id: $old -> $new"
    if [ "${3:-}" != --no-restart ]; then
      dc rm -sf "$id" >/dev/null 2>&1 || true
      sync_prompts   # the roster's Runtime column changed for everyone
      dc up -d "$id" 2>&1 | grep -E "Started|Error" || true
      if [ "$new" = codex ]; then echo "codex sign-in needed: agentctl login-codex $id"; fi
    fi ;;

  add)
    id=${1:?id}; rt=${2:?runtime}; shift 2
    name=""; about=""; respond="owner-only"; mem="2g"; kind="team"; model="-"; effort="-"
    while [ $# -gt 0 ]; do case "$1" in
      --name) name=$2; shift 2;; --about) about=$2; shift 2;;
      --respond-to) respond=$2; shift 2;; --mem) mem=$2; shift 2;; --kind) kind=$2; shift 2;;
      --model) model=$2; shift 2;; --effort) effort=$2; shift 2;;
      *) die "unknown option $1";; esac; done
    [[ "$id" =~ ^[a-z][a-z0-9-]{1,30}$ ]] || die "id must be lowercase letters/digits/dashes"
    [[ "$rt" =~ ^(claude|codex)$ ]] || die "runtime must be claude or codex"
    [[ "$respond" =~ ^(owner-only|anyone|nobody)$ ]] || die "bad --respond-to"
    [ -n "$name" ] || name=$id
    grep -q "^$id " agents.list && die "$id already exists"
    umask 077
    out=$(docker run --rm --entrypoint /usr/local/bin/buzz-admin "$KEYGEN_IMAGE" generate-key)
    sk=$(awk '/Secret key:/{print $3}' <<<"$out"); pk=$(awk '/Public key:/{print $3}' <<<"$out")
    [[ "$sk" =~ ^[0-9a-f]{64}$ && "$pk" =~ ^[0-9a-f]{64}$ ]] || die "key generation failed"
    {
      echo "BUZZ_PRIVATE_KEY=$sk"
      echo "BUZZ_ACP_AGENT_COMMAND=$([ "$rt" = claude ] && echo claude-agent-acp || echo codex-acp)"
      echo "BUZZ_ACP_AGENT_OWNER=$OWNER_HEX"
      echo "BUZZ_ACP_RESPOND_TO=$respond"
      echo "BUZZ_ACP_SYSTEM_PROMPT_FILE=/prompts/$id.md"
    } > "$id.env"
    printf '%s\n%s\n' "$name" "$about" > "$id.meta"
    echo "$pk" > "$id.pub"; chmod 644 "$id.pub"
    echo "$id $rt $mem $kind" >> agents.list
    [ "$model$effort" = -- ] || set_model "$id" "$model" "$effort"
    render
    dc create "$id" >/dev/null 2>&1
    prep_home "$id" "$rt"
    sync_prompts   # builds the new agent's prompt, starts it, and restarts others (roster changed)
    set_profile "$id" "$name" "$about"
    echo "added $id ($rt): $(npub "$pk")"
    if [ "$rt" = codex ] && [ ! -s "$(docker volume inspect -f '{{.Mountpoint}}' "buzz-agents_$id-home")/.codex/auth.json" ]; then
      echo "codex sign-in needed:"; login_codex "$id"
    fi
    ;;

  profile) id=${1:?id}; shift; n=""; a=""
    while [ $# -gt 0 ]; do case "$1" in --name) n=$2; shift 2;; --about) a=$2; shift 2;; *) die "unknown option $1";; esac; done
    set_profile "$id" "$n" "$a"
    printf '%s\n%s\n' "$n" "$a" > "$id.meta"; sync_prompts ;;
  login-codex) login_codex "${1:?id}" ;;
  restart) dc up -d --force-recreate "${1:?id}" ;;
  logs) dc logs --no-color --tail "${2:-50}" "${1:?id}" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' ;;
  remove)
    id=${1:?id}; grep -q "^$id " agents.list || die "no agent $id"
    dc rm -sf "$id" >/dev/null 2>&1 || true
    sed -i "/^$id /d" agents.list; render; rm -f "prompts/$id.md"
    if [ "${2:-}" = --purge ]; then
      docker volume rm "buzz-agents_$id-home" "buzz-agents_$id-ws" >/dev/null 2>&1 || true
      docker network rm "buzz-agents_$id-net" >/dev/null 2>&1 || true
      rm -f "$id.env" "$id.pub" "$id.meta" "$id.skills" "prompts/src/$id.md"; echo "removed $id (key, volumes and prompt deleted)"
    else echo "removed $id (key and volumes kept in /opt/buzz-agents)"; fi
    sync_prompts ;;
  render) render ;;
  sync) sync_prompts ;;
  mirror)
    ids=${*:-$(awk '{print $1}' agents.list)}
    for id in $ids; do
      printf '%-10s ' "$id"
      dc exec -T "$id" /opt/agent-tools/mem-mirror "$(sed -n 1p "$id.meta" 2>/dev/null || echo "$id")" </dev/null 2>&1 | tail -2 | tr '\n' ' '; echo
    done ;;
  listen)
    id=${1:?id}; shift; grep -q "^$id " agents.list || die "no agent $id"
    if [ $# -gt 0 ]; then echo "$*" | tr -d '#' > "$id.listen"; else rm -f "$id.listen"; fi
    sync_prompts ;;
  respond-to)
    id=${1:?id}; m=${2:?mode}; [[ "$m" =~ ^(owner-only|anyone|nobody)$ ]] || die "bad mode"
    grep -q "^$id " agents.list || die "no agent $id"
    sed -i '/^BUZZ_ACP_RESPOND_TO=/d' "$id.env"; echo "BUZZ_ACP_RESPOND_TO=$m" >> "$id.env"
    build_prompts >/dev/null; dc up -d --force-recreate $(awk '{print $1}' agents.list) 2>&1 | grep -E "Error" || true
    echo "$id now responds to: $m" ;;
  auth)
    id=${1:?id}; t=${2:?auth tag json}; grep -q "^$id " agents.list || die "no agent $id"
    [[ "$t" =~ ^\[\"auth\",\"[0-9a-f]{64}\",\"[^\"]*\",\"[0-9a-f]{128}\"\]$ ]] || die "not an auth tag"
    sed -i '/^BUZZ_AUTH_TAG=/d' "$id.env"; echo "BUZZ_AUTH_TAG=$t" >> "$id.env"
    echo "$id: owner proof set (restart to apply)" ;;
  prune-exchange)
    days=${1:-30}; [[ "$days" =~ ^[0-9]+$ ]] || die "days must be a number"
    [ -d exchange ] || exit 0
    find exchange -mindepth 2 -maxdepth 2 -mtime +"$days" -print -exec rm -rf {} + | sed 's/^/pruned /' ;;
  build) build_prompts ;;
  prep-all) while read -r i r _; do [ -n "${i:-}" ] && prep_home "$i" "$r"; done < agents.list; render ;;
  *) die "unknown command $cmd" ;;
esac
